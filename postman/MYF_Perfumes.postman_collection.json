{
  "info": {
    "name": "MYF Perfumes API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"admin@myf.local\", \"password\": \"Admin123*\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "Listar productos",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/productos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos"
          ]
        }
      }
    },
    {
      "name": "Configurar stock producto 1",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"stockActual\": 5, \"stockMinimo\": 2}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/inventario/1/configurar",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "inventario",
            "1",
            "configurar"
          ]
        }
      }
    },
    {
      "name": "Registrar venta",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"usuarioId\": 1, \"descuento\": 0, \"metodoPago\": \"YAPE\", \"items\": [{\"productoId\": 1, \"cantidad\": 1}]}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/ventas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "ventas"
          ]
        }
      }
    },
    {
      "name": "Alertas",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/alertas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "alertas"
          ]
        }
      }
    },
    {
      "name": "Reporte ventas",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/reportes/ventas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reportes",
            "ventas"
          ]
        }
      }
    }
  ]
}